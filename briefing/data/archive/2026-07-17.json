 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "청년 일경험 4.5만명으로 늘린다 — SK하이닉스·네이버도 함께",
   "kicker": "4.5만명 · 3년 14만명 · 특화 1,500명",
   "three_step": {
    "what": "고용노동부가 7월 16일 청년 일경험 민관협의회를 열고 올해 4만5천명에게 일경험을 제공하겠다고 밝혔다. SK하이닉스·삼성전자·LG·네이버·카카오 등이 참여한다.",
    "evidence": "정부는 2023년부터 「미래내일 일경험」으로 3년간 약 14만명에게 일경험을 제공했다. 올해는 준비 중인 청년을 위해 멘토 밀착 지원과 일경험 시간 단축을 적용한 특화 프로그램(1,500명)을 운영하고, 4월 추가경정예산으로 사회적기업 일경험인 '사회적가치형'을 만들어 2천명에게 기회를 더했다(2026년 7월 16일, 고용노동부).",
    "implication": "경력 공백이 있는 청년에게 일경험을 '인턴 한 번'이 아니라 직무경험을 쌓는 제도로 소개하고, 특화 프로그램처럼 시간을 줄인 과정도 선택지로 제시하라."
   },
   "key_numbers": [
    {
     "label": "올해 목표",
     "value": "4.5만명",
     "delta": "2026년",
     "period": "2026년"
