 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "학력·경력 없어도 국가기술자격 — 응시자격 문턱 낮춘다",
   "kicker": "4.3 포럼 · 청년·비전공자·중장년 · 역량 중심",
   "three_step": {
    "what": "고용노동부가 4월 3일 국가자격 제도발전 포럼 제1차 회의를 열고 국가기술자격 응시자격 개편 방안을 논의했다.",
    "evidence": "학력·경력 위주의 경직된 응시자격과 긴 경력 요건 때문에 청년·비전공자·중장년이 시험 응시에 어려움을 겪어 왔다는 현장 목소리를 반영했다. 전문가들은 역량을 갖춘 청년의 기회 확대를 위해 응시자격을 다양화해야 한다고 제언했고, 정부는 산업현장에 필요한 역량 중심 자격 체계로 개편을 추진한다(2026년 4월 3일, 고용노동부).",
    "implication": "자격증으로 이직하려는 비전공·중장년 내담자에게 응시자격 요건이 바뀌는 중이라는 점을 알려 주고, 현행 요건과 개편 후 요건을 함께 확인하게 하라."
   },
