 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "소규모 사업장 4,500곳 점검 — 컨설팅과 감독을 나눠서",
   "kicker": "4,500곳 · 17개 시·도 · 12월 지방 위임",
   "three_step": {
    "what": "고용노동부가 4월 20일 지역 기초노동질서 점검 운영계획을 내놨다. 전국 17개 시·도와 함께 소규모 사업장 1,500곳은 예방감독, 3,000곳은 기초노동질서 준수 컨설팅을 한다.",
    "evidence": "올해 12월 「노동감독관 직무집행법」 시행으로 지방정부에 감독권한이 위임되는 만큼, 그 전에 중앙-지방 협업체계를 만드는 사전 단계다. 2022년부터 이어온 계도 중심 '현장예방 점검의 날'과 달리 이번에는 즉시 시정을 요구하는 감독 본연의 역할을 강화한다(2026년 4월 20일, 고용노동부).",
    "implication": "영세 사업장 내담자에게 감독과 컨설팅이 다르게 운영된다는 점을 알려 주고, 신고 없이도 찾아오는 예방감독 대상인지 확인하게 하라."
   },
