 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "포스코에 특단 대책 요구 — 떨어짐 사망 한 건이 마지막이 아니었다",
   "kicker": "6.9 사망 1명 · 경영진 5명 면담 · 재발방지 요구",
   "three_step": {
    "what": "고용노동부 장관이 6월 15일 포스코 그룹 회장과 계열사 대표들을 만나 중대재해 재발방지를 위한 그룹 차원의 대책을 마련하라고 촉구했다. 6월 9일 포스코이앤씨 신안산선 공사현장에서 떨어짐 사망사고가 난 직후다.",
    "evidence": "사고는 6월 9일 17시 26분께 서울 관악구 철도 공사현장 전기 배관실 개구부에서 발생해 1명이 숨졌다. 장관은 포스코 계열 사업장에서 같은 유형의 중대재해가 반복되는 점을 지적하며 위험 현장에 대한 본사 안전투자 확대와 현장 작동성을 요구했다(2026년 6월 15일, 고용노동부).",
    "implication": "건설·플랜트 협력업체 소속 내담자에게 개구부·단부 등 떨어짐 위험 구간의 방호 조치와 작업 전 안전점검 기록을 확인하게 하라."
   },
   "key_numbers": [
    {
     "label": "사고",
     "value": "2026년 6월 9일",
