 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "공무직위원회 출범, 공공부문 비정규직 논의 창구 열렸다",
   "kicker": "9월 18일 출범 · 국무조정실장 위원장",
   "three_step": {
    "what": "공무직위원회가 「공무직위원회 설치 및 운영에 관한 법률」 시행 첫날인 9월 18일 공식 출범했다. 공공부문 비정규직 노동자의 고용·임금 등 근로조건을 다루는 범정부 협의기구다.",
    "evidence": "위원회는 국무조정실장을 위원장으로 관계부처와 노·사 대표, 전문가가 참여한다. 법은 올해 2월 제정됐고, 그동안 노동계·전문가·관계부처가 「노정전 사전협의체」를 꾸려 운영체계와 시행령을 함께 준비해 왔다. 위원회는 공무직의 근로조건과 인사·노무·교육 정책을 심의·조정한다(2026년 9월 18일, 고용노동부).",
    "implication": "공공기관 무기계약·공무직 일자리를 상담할 때, 처우 개선 창구가 법정 위원회로 생겼다는 점을 알려 주고 기관별 단체협약 시기를 확인하게 하라."
   },
