 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "허위근로자 57명 모집한 사업주, 구속됐다",
   "kicker": "부정수급 5.8억원 · 7년간 5개 사업장",
   "three_step": {
    "what": "브로커를 동원해 허위근로자 57명을 모집하고 실업급여를 받게 한 사업주가 구속됐다. 사업주와 브로커가 역할을 나눠 7년간 반복한 조직적 부정수급 사건이다.",
    "evidence": "대구지방고용노동청은 사업주 A씨가 2019년 3월부터 2026년 2월까지 5개 사업장에서 브로커 4명 등을 통해 허위근로자를 모집하고 고용보험 피보험자격을 허위 신고한 혐의로 구속했다. 부정수급액은 5억8천여만원으로 구직급여 5억4천여만원, 고용유지지원금 2천여만원, 청년채용특별장려금 2천여만원이다. 대구지법은 9월 16일 구속영장을 발부했다(2026년 9월 17일, 고용노동부).",
    "implication": "실업급여·장려금을 안내할 때 허위 근로 이력이 부정수급으로 형사처벌까지 갈 수 있음을 사례로 짚고, 이력 기재는 실제 근무한 사실만 하도록 확인하라."
   },
