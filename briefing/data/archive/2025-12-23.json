 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "직업계고 학생 67명 '기특한 명장' — 노동부·교육부, 교육부터 취업까지 손잡다",
   "kicker": "67명(학생 20·기술 47) · 장관상 39점 · 졸업 후까지",
   "three_step": {
    "what": "고용노동부와 교육부가 12월 23일 직업계고 학생의 교육·훈련·취업 지원을 위한 업무협약을 맺고, 제1기 '기술인재특별한대한민국명장(기특한 명장)' 증서 67점(학생회원 20명·기술회원 47명)과 장관상 39점(학생회원 20점·학생을 배출한 학교 19곳)을 수여했다.",
    "evidence": "협약에 따라 교육부가 성장 가능성이 높은 직업계고 인재를 발굴하면 노동부가 교육·훈련·연수로 지원하고, AI·디지털 등 첨단산업부터 건설업 등 뿌리산업까지 실습 중심 교육을 확대한다. 졸업 전에는 학생 수요에 맞춘 취업지원 프로그램을, 졸업 후에는 두 부처 정보연계로 취업에 어려움을 겪는 졸업생을 먼저 찾아가는 집중 지원을 제공한다. 현장실습 사업장에는 안전보건공단 등과 함께 사전 안전점검·기술지도를 하고, 교원을 노동인권 지도교사로 양성해 근로계약·임금·부당처우 교육을 맡긴다(2025년 12월 23일).",
    "implication": "직업계고 출신 구직자 상담에서 졸업 후 지원 프로그램과 현장실습 안전점검을 안내하고, 취득한 자격을 기특한 명장(학생회원→기술회원) 트랙과 이어 붙여 기술 성장의 다음 단계를 보여 주라."
   },
