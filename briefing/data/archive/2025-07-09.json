 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "체불 취약 10대 건설기업 통합감독 — 감독관 100여 명 투입",
   "kicker": "10개사 · 100여 명 · 50억 이상 현장까지",
   "three_step": {
    "what": "고용노동부가 최근 2년간 임금체불이 다수 발생한 10개 종합건설기업을 대상으로 7월 9일부터 노동·산재·외국인 통합감독에 착수했다.",
    "evidence": "서울·중부·부산·대구·광주 5개청의 광역근로감독과와 건설산재지도과, 지역협력과가 합동팀을 꾸려 100여 명의 감독관이 투입된다. 본사뿐 아니라 이들 기업이 시공하는 50억원 이상 주요 현장의 하도급 업체까지 포함해 노무관리·안전보건 관리체계, 외국인 불법 고용 등 법 위반을 집중 점검한다. 원·하청 간 불공정 관행과 불법 하도급도 함께 살펴 관계부처 협업으로 개선을 권고한다(2025년 7월 9일).",
    "implication": "건설 하도급 근로자 내담자에게 통합감독 대상 기업·현장과 감독 항목(체불, 안전, 외국인 고용)을 알려 주고, 신고 시 회사명·현장·하도급 단계를 구체적으로 적게 하라."
   },
