 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "돌봄 종사자 처우개선, 정부와 민주노총이 협의 시작",
   "kicker": "인건비 가이드라인 2027년 100% · 보육교사 월 2만원",
   "three_step": {
    "what": "정부가 5월 11일 보건복지부에서 민주노총과 만나 돌봄 종사자 처우개선을 위한 노정협의체 구성을 논의했다. 개정 노조법 시행 뒤 돌봄 분야 사회적 대화를 시작하는 자리다.",
    "evidence": "보건복지부는 사회복지 종사자 임금 현실화를 국정과제로 두고 2027년까지 사회복지시설 인건비 가이드라인 준수율 100%를 목표로 삼았다. 교육부는 보육교사 처우개선비를 전년보다 월 2만원 올리고, 대체교사에게 교통비 월 10만원과 월 15일 이상 근무 조건을 붙이기로 했다(2026년 5월 11일, 보건복지부·교육부 합동).",
    "implication": "돌봄·보육·사회복지 종사자 내담자에게 인건비 가이드라인과 처우개선비가 적용되는지 확인하게 하고, 시설 유형별 기준을 비교해 보여 주라."
   },
   "key_numbers": [
    {
