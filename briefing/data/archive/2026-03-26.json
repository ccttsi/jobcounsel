 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "화재·폭발 고위험 1,000곳 긴급점검 — 대전 사망사고 뒤",
   "kicker": "3.26~4.7 · 1,000곳 · 4대 안전수칙",
   "three_step": {
    "what": "고용노동부가 3월 26일부터 4월 7일까지 건설현장·제조업 등 화재·폭발 고위험 사업장 1,000곳을 긴급 점검한다.",
    "evidence": "3월 20일 대전 대덕구 제조업체에서 노동자가 숨진 화재사고가 계기가 됐다. 점검 항목은 가연물 파악·안전장소 보관, 화재 위험작업 작업계획, 용접·용단 시 불티 비산 방지, 비상구 설치·관리다. 위반이 확인되면 과태료와 사법 조치로 바로 이어진다(2026년 3월 25일, 고용노동부).",
    "implication": "제조·건설 내담자에게 화기작업 전 작업계획과 소화기·비상구 위치를 확인하게 하고, 가연물이 쌓인 작업장이라면 사진을 남겨 두라고 안내하라."
   },
