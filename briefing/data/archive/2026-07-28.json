 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "폭염 취약사업장 1,000곳 점검, 체감 35도면 옥외작업 중단",
   "kicker": "8.3~8.14 · 1,000곳 · 48개 지방관서",
   "three_step": {
    "what": "고용노동부가 8월 3일부터 14일까지 2주간 폭염 취약사업장과 밀폐공간 질식 고위험사업장 1,000곳을 집중점검한다. 폭염을 재난으로 보고 대응하는 조치다.",
    "evidence": "점검은 건설·조선·물류·제조업을 대상으로 '폭염안전 5대 기본 수칙' 이행 여부를 확인한다. 장관은 전국 48개 지방관서장에게 체감온도 35도 이상이면 옥외작업 중단이나 시간대 조정, 38도 이상이면 긴급조치 외 모든 옥외작업 중단을 확인하라고 지시했다. 맨홀·오폐수처리시설·저장탱크 등 밀폐공간은 질식사고 예방 3대 수칙도 함께 본다(2026년 7월 28일, 고용노동부).",
    "implication": "야외·물류·건설 내담자에게 체감온도 35도·38도 기준을 숫자로 알려 주고, 작업 중단 요구를 '권리'로 말할 수 있게 문장을 연습시켜라."
   },
   "key_numbers": [
