 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "장관, 밤 10시 반 물류센터 불시점검 — 야간노동 건강권",
   "kicker": "11.28 22:30 · 쿠팡 물류센터 실태점검 지시 · 건강진단·휴게시설",
   "three_step": {
    "what": "김영훈 고용노동부 장관이 11월 28일 오후 10시 30분 고양시 물류센터를 불시에 찾아 야간노동과 안전수칙 준수 여부를 점검했다. 쿠팡물류센터 야간근무 노동자 사망사고 이후 야간노동자 과로·건강 문제 우려가 커진 데 따른 것이다.",
    "evidence": "장관은 업무·휴게시간, 건강진단 실시 여부와 진단 결과 사후관리, 휴게시설 설치 여부를 확인하고 야간근무 노동자의 애로를 청취했다. 이 자리에서 심야노동을 반복하면 뇌심혈관계질환 등 심각한 타격이 될 수 있다며 건강권 보호 조치를 당부했고, 상시 야간노동이 이뤄지는 쿠팡 물류센터와 배송센터의 장시간 야간노동·건강권 보호조치 실태를 긴급 점검하라고 지시했다(2025년 11월 28일).",
    "implication": "물류·배송 야간 근로자 내담자에게 건강진단 결과 사후관리와 휴게시설 기준을 확인하게 하고, 과로로 건강이 나빠졌을 때 산재 신청과 근로감독 청구로 이어지는 경로를 안내하라."
   },
