 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "쿠팡 감독관 접대 의혹, 특정감사 결과 수사의뢰·징계 조치",
   "kicker": "2025.12.24 감사 · 식사·알선 정황 · 수사의뢰",
   "three_step": {
    "what": "고용노동부가 쿠팡 감독 과정의 감독관 접대·봐주기 의혹과 관련해 특정감사 결과를 2월 13일 발표하고 수사의뢰와 징계 등 강력 조치를 예고했다.",
    "evidence": "장관 특별지시로 2025년 12월 24일부터 감사를 시작해 언론에서 제기된 의혹뿐 아니라 여타 비위와 감독규정 준수 여부까지 확인했다. 감독관이 쿠팡 관계자와 식사한 정황, 감독 후 특정 안전보건 교육기관을 소개·알선한 정황이 관계자 진술과 자료로 일부 확인됐다. 당사자는 부인하고 있고, 징계시효가 지난 사안이라 수사기관에 넘기기로 했다(2026년 2월 13일, 고용노동부).",
    "implication": "감독 결과를 신뢰하지 못하는 내담자에게 감독관 비위도 감사·수사 대상이 된다는 점을 알려 주고, 부당한 감독을 겪었다면 근거 자료와 함께 이의를 제기하게 하라."
   },
