 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "폭염 속 필수업무 6개 직종 근무환경 악화, 원유 위기도 조사한다",
   "kicker": "6개 직종 · 생활지원사·도로보수원 · 2026 원유 수급",
   "three_step": {
    "what": "고용노동부가 5월 26~27일 필수업무 지정 및 종사자 지원위원회를 열고, 2025년 폭염 재난 때 필수업무 종사자 실태조사 결과를 공유했다. 생활지원사·도로보수원 등 6개 직종의 근무환경이 나빠진 것으로 확인됐다.",
    "evidence": "위원회는 산불(2022년), 해양선박사고(2023년), 다중밀집시설 재난(2024년)처럼 해마다 재난 유형을 골라 실태를 조사해 왔다. 2026년 조사 주제로는 '원유 수급 위기'를 골라 에너지 공급망 종사자를 선제적으로 보호하기로 했다(2026년 5월 27일, 고용노동부).",
    "implication": "돌봄·도로·에너지처럼 재난 때도 멈추지 않는 일에 종사하는 내담자에게 폭염·위기 상황의 작업 중지 기준과 보호 장비를 확인하게 하라."
   },
   "key_numbers": [
