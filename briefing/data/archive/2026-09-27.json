 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "중장년고용 강조주간 시작, 지역에서 경력설계·직업훈련 연다",
   "kicker": "9.28~10.2 · 제21회 · 중장년내일센터 중심",
   "three_step": {
    "what": "고용노동부가 제21회 중장년고용 강조주간(9월 28일~10월 2일)을 맞아 지역 맞춤형 경력지원 행사를 집중 실시한다.",
    "evidence": "슬로건은 '지역을 잇다, 중장년을 키우다'로, 경력설계·일경험·직업훈련 등 지역 안의 경력지원서비스를 제공한다. 9월 30일 노사발전재단 주관 기념행사에서 개인 부문 최명철 씨(식당 운영 10여 년 뒤 중장년 특화훈련을 받고 반도체 기업 취업)와 ㈜해양공사(검수기업 공동 직무설명회·직무교육으로 중장년 채용)가 장관상을 받는다(2026년 9월 27일, 고용노동부).",
    "implication": "40~50대 내담자에게 이번 주 지역 중장년내일센터 행사 일정을 안내하고, 경력설계 상담을 이번 주 안에 예약하게 하라."
   },
