 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "청년 일경험 민관협의회 — '쉬는 청년' 40만명, 경력직 채용의 문턱",
   "kicker": "쉬는 청년 40만명 · 우수기업 4곳 · 2026년 특화 프로그램",
   "three_step": {
    "what": "고용노동부가 12월 19일 대한상공회의소에서 2025년 제2차 청년 일경험 민·관협의회를 열고 우수사례 공모전 수상 기업 4곳에 장관상을 수여했다. 삼성전자, KT, CJ올리브네트웍스, LG AI연구원, 산업안전상생재단 등이 참여해 일경험과 청년 취업지원 확대를 논의했다.",
    "evidence": "권창준 차관은 경력 중심 채용이 굳어지고 AI 등 기술 변화가 빨라지면서 청년이 노동시장에 첫발을 내딛는 문턱이 높아졌고, 잠시 멈춰 숨을 고르는 청년도 40만명에 이른다고 밝혔다. 최우수상을 받은 카카오 계열 링키지랩은 청년들의 아이디어가 AI 학습데이터 품질 향상 등 실제 업무 성과로 이어지고 채용으로 연결됐다고 했고, 현대홈쇼핑은 IT·방송 등 5개 직무에서 실무 경험을 제공했다. 정부는 2026년에도 청년 수요에 맞는 특화 일경험 프로그램으로 사업의 질을 높이겠다고 했다(2025년 12월 19일).",
    "implication": "경력이 없는 청년 내담자에게 일경험을 '경력직 선호' 장벽을 낮추는 첫 단계로 설명하고, 참여 기업에서 맡은 직무를 이력서에 어떤 성과로 정리할지 함께 설계하라."
   },
