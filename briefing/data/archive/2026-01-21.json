 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "포스코이앤씨 4년 새 중대재해 9건, 위반 403건 적발",
   "kicker": "9건 · 403건 · 현장 62곳",
   "three_step": {
    "what": "고용노동부가 1월 20일 포스코이앤씨 본사와 전국 현장에 대한 안전보건감독 결과를 발표했다. 2025년에만 사망사고 5건이 발생한 사업장이다.",
    "evidence": "'중대재해처벌법 시행 이후 2023년 1건, 2024년 3건, 2025년 5건으로 모두 9건의 중대재해가 났다. 2025년 8월 11일부터 10월 31일까지 전국 현장 62곳과 본사를 감독해 산업안전보건법 위반 403건을 적발하고 행정·사법 조치했다. 노동부·안전보건공단·외부 전문가가 참여해 본사 안전보건관리체계를 진단하고 개선을 권고했다(2026년 1월 20일, 고용노동부).",
    "implication": "건설 협력업체 내담자가 포스코이앤씨 현장에서 일한다면 최근 사고 이력과 안전조치를 먼저 확인하게 하고, 위험하다고 느끼면 작업 거부와 신고를 안내하라."
   },
