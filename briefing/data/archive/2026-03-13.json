 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "산재보상 혁신 지원단 출범 — 전국민 산재보험·선보장 논의",
   "kicker": "3.12 출범 · 4개 분과 · 산재 선보장",
   "three_step": {
    "what": "고용노동부가 3월 12일 서울지방고용노동청에서 「산재보상·일터복귀 종합지원단」 킥오프 회의를 열고 활동을 시작했다.",
    "evidence": "지원단은 전국민 산재보험, 산재보험 선보장, 신속처리 등 제도 혁신을 논의하는 민·관 전문가 협의체다. 산업안전보건본부장을 위원장으로 산재보험, 치료·재활·복귀, 업무상 질병 등 4개 분과로 나눠 과제를 추진한다(2026년 3월 12일, 고용노동부).",
    "implication": "산재를 겪은 내담자에게 보상 결정 전에 치료비를 먼저 받는 선보장 논의가 진행 중이라는 점을 알려 주고, 신청 단계에서 필요한 서류를 미리 준비하게 하라."
   },
   "key_numbers": [
    {
     "label": "출범",
