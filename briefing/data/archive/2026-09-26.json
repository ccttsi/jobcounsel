 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "해외 노동시장",
   "title": "미국 민간 노동자 71% 의료보험 문은 있는데, 가입은 46%뿐",
   "kicker": "퇴직연금 접근 72%·가입 52% · 유급병가 81%",
   "three_step": {
    "what": "2026년 3월 기준 미국 민간기업 노동자의 71%가 고용주 의료보험에 가입할 수 있었지만 실제 가입자는 46%였다. 퇴직연금은 72%가 가입할 수 있고 52%가 가입했다.",
    "evidence": "유급 휴가는 80%, 유급 공휴일과 유급 병가는 각각 81%, 가족·의료휴가는 49%, 개인 휴가는 51%가 이용할 수 있었다. 유급 병가 접근률은 숙박·음식 58%에서 정보·금융보험 98%까지 벌어졌고, 학자금 상환 지원은 임금 하위 25% 3%·상위 25% 15%였다(2026년 9월 25일, BLS).",
    "implication": "해외 취업이나 외국계 기업을 비교하는 내담자에게 복지가 있다와 내가 받는다가 다르다는 것을 수치로 보여 주고, 연봉 협상 때 가입률과 본인부담을 함께 물으라고 안내하라."
   },
