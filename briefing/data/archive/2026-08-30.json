 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "푸른씨앗 적립금 1.9조원, 제2기 운용기관 다시 선정",
   "kicker": "사업장 4.2만곳 · 누적수익률 34.48%",
   "three_step": {
    "what": "근로복지공단이 중소기업퇴직연금기금 '푸른씨앗'의 제2기 전담운용기관으로 삼성자산운용·미래에셋증권을, 주거래은행으로 우리은행을 다시 선정하고 9월 1일부터 제2기 사업을 시작한다.",
    "evidence": "푸른씨앗은 출범 4년 만에 가입 사업장 약 4만2,000곳, 가입자 약 19만명, 적립금 약 1조9,000억원으로 커졌다. 2026년 6월 기준 누적수익률은 34.48%이고 연도별 수익률은 2023년 6.97%, 2024년 6.52%, 2025년 8.67%였다. 여러 중소기업의 퇴직연금을 한 기금으로 모아 운용하는 국내 첫 공적 기금형 퇴직연금이며, 7월에는 개인형(푸른씨앗 IRP)으로 넓혀 자영업자·노무제공자도 가입할 수 있게 했다(2026년 8월 30일, 근로복지공단).",
    "implication": "퇴직연금을 안내할 때 300인 미만 중소기업 재직자에게 푸른씨앗과 IRP 가입 경로를 함께 알려 주게 하라."
   },
