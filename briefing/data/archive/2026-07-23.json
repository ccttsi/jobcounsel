 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "지방 노동감독 시대 — 경기도, 감독관 170명 채용 착수",
   "kicker": "감독관 170명 · 12월 8일 시행 · 사업장 최다 지역",
   "three_step": {
    "what": "고용노동부와 경기도가 7월 22일 중앙-지방 노동감독 협업체계 업무협약을 맺었다. 12월 8일 「노동감독관 직무집행법」 시행을 앞두고 지방정부가 직접 감독에 나서는 첫 사례다.",
    "evidence": "경기도는 전국에서 사업장과 노동자가 가장 많고 제조·건설 등 위험 업종과 영세사업장이 밀집해 있다. 경기도지사직 인수위원회는 120대 정책제안 중 '지방노동감독관 신속 도입'을 최우선으로 꼽았고, 도는 감독관 170명 채용 절차에 들어갔다. 노동부는 법령·지침 정비, 감독관 교육, 전산 인프라를 지원한다(2026년 7월 22일, 고용노동부).",
    "implication": "경기도 소재 영세사업장 내담자에게 신고·감독 창구가 지방정부로 넓어진다는 점을 알려 주고, 임금체불·안전 신고 시 어디로 연락할지 함께 확인하게 하라."
   },
