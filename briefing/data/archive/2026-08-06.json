 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "이름을 불러 주세요 — 이주노동자 노동존중 캠페인",
   "kicker": "150여 명 참석 · 4개 재단 · 4월 협약",
   "three_step": {
    "what": "고용노동부와 4개 노동권익재단이 8월 5일 충남 아산에서 이주노동자 노동존중 캠페인을 열었다. '야', '너' 대신 이름을 부르는 문화를 일터에 퍼뜨리는 자리다.",
    "evidence": "충남·대전 지역 기업 관계자와 이주노동자 등 150여 명이 참석했고, 이주노동자에게 이름이 새겨진 안전모를 전달했다. 캠페인은 4월 체결한 노동권익 향상 업무협약에 따라 4월 울산, 5월 광주, 6월 경북 예천에 이어 전국에서 이어지고 있다(2026년 8월 5일, 고용노동부).",
    "implication": "이주노동자 내담자와 상담할 때 호칭·통역·안전교육 언어를 먼저 확인하라. 이름과 언어를 존중하는 사업장인지가 이직 판단의 기준이 된다."
   },
   "key_numbers": [
    {
     "label": "참석",
     "value": "150여 명",
