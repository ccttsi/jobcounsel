 "cards": [
  {
   "id": "c01",
   "order": 1,
   "track": "A",
   "category": "국내 고용행정",
   "title": "Arm 스쿨 신설 — 5년간 반도체 설계 인력 1,400명 양성",
   "kicker": "1,400명 · 2026~2030년 · 반도체 IP 설계",
   "three_step": {
    "what": "산업통상부가 12월 5일 글로벌 반도체 설계자산(IP) 기업 Arm과 「한국 반도체·AI 산업 강화」 양해각서를 맺고, 2026년부터 (가칭)Arm 스쿨을 운영해 5년간 약 1,400명의 인력을 양성하기로 했다.",
    "evidence": "양해각서는 산업 맞춤형 인재 양성(1,400명), 기술교류와 생태계 강화, 대학 간 연계, 연구개발 협력을 담고 있으며, 이행을 위한 워킹그룹을 만든다. Arm은 애플·구글·MS와 삼성·엔비디아·퀄컴 등이 의존하는 컴퓨터 설계 플랫폼으로, 정부는 Arm과 함께 국내 IP 전문인력을 길러 상대적으로 취약한 팹리스·파운드리 등 시스템 반도체 경쟁력을 높이겠다고 밝혔다. 협약은 이재명 대통령과 손정의 소프트뱅크 회장, 르네 하스 Arm CEO 회담을 계기로 추진됐다(2025년 12월 5일).",
    "implication": "반도체·전자 계열 구직자 내담자에게 Arm 스쿨 같은 글로벌 기업 연계 훈련이 2026년부터 열린다는 점을 알려 주고, 설계(팹리스)와 공정(파운드리) 중 어느 쪽 역량을 쌓을지 진로를 구체화하게 하라."
   },
