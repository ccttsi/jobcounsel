<?xml version="1.0" encoding="utf-8"?>
<!-- AdapterViewFlipper는 ObjectAnimator 하나만 받는다 → 떠오름·나타남을 한 애니메이터에 묶는다(transform·opacity만) -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="360"
    android:startOffset="90"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <propertyValuesHolder android:propertyName="translationY" android:valueFrom="36" android:valueTo="0" android:valueType="floatType" />
    <propertyValuesHolder android:propertyName="alpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
</objectAnimator>
