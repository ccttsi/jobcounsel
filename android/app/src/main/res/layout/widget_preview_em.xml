<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_em"
    android:orientation="vertical"
    android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed" android:letterSpacing="0.16" android:text="EMERGING"
        android:textColor="@color/label_em" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="이머징 인더스트리" android:textColor="@color/ink"
        android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/widget_emerging_desc" android:textColor="@color/muted"
        android:textSize="12.5sp" />
</LinearLayout>
