<?xml version="1.0" encoding="utf-8"?>
<!-- 카드 한 장: 머리(갈래 표지·쪽번호) / 큰 숫자 + 단위 / 제목 / 부제 / 진행 줄 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="15dp"
    android:paddingEnd="18dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.16"
            android:textColor="@color/label_br"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/muted"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/folio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="0.06"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/numrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:lineBreakWordStyle="phrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="2"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="11.5sp" />

    <!-- 위젯을 세로로 키우면 요약이 남는 높이에 맞는 줄 수만큼 보인다(줄 수는 위젯 높이로 계산) -->
    <TextView
        android:id="@+id/body"
        android:lineBreakWordStyle="phrase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="top"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <!-- 진행 줄은 오른쪽 아래 ◀ ▶ 단추(44dp, 아래 8dp)와 같은 높이의 띠 한가운데에 앉는다 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical|start"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/prog_br"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="132dp"
            android:layout_height="3dp"
            android:max="100"
            android:progressDrawable="@drawable/prog_br" />

        <ProgressBar
            android:id="@+id/prog_em"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="132dp"
            android:layout_height="3dp"
            android:max="100"
            android:progressDrawable="@drawable/prog_em"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
